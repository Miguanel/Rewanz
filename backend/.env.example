# Skopiuj do backend/.env (plik .env NIE trafia do gita)

ENV=development
# Lokalnie SQLite (zero konfiguracji) albo Postgres z docker-compose:
DATABASE_URL=sqlite:///./rewanz.db
# DATABASE_URL=postgresql://rewanz:rewanz@localhost:5432/rewanz

# min. 32 znaki; wygeneruj: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=zmien-mnie-na-dlugi-losowy-ciag-min-32-znaki
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Tylko lokalnie: tworzenie tabel bez Alembica + dane demo przy starcie
AUTO_CREATE_TABLES=false
SEED_DEMO=false
